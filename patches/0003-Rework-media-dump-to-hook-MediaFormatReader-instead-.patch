+void MediaFormatReader::StartMediaDump(const nsACString& aDirPath) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsCString dirPath(aDirPath);
+  nsresult rv = mTaskQueue->Dispatch(NS_NewRunnableFunction(
+      "MediaFormatReader::StartMediaDump",
+      [self = RefPtr{this}, dirPath]() {
+        if (self->mDumpMuxer || self->mMediaDumpStopped) {
+          return;  // Already armed, or explicitly stopped: first call wins.
+        }
+        self->mDumpMuxer = MakeUnique<MediaDumpMuxer>();
+        self->mDumpMuxer->Init(dirPath,
+                               self->HasVideo() ? &self->mInfo.mVideo
+                                                 : nullptr,
+                               self->HasAudio() ? &self->mInfo.mAudio
+                                                 : nullptr);
+      }));
+  NS_ENSURE_SUCCESS_VOID(rv);
+}
+
+void MediaFormatReader::StopMediaDump() {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsresult rv = mTaskQueue->Dispatch(
+      NS_NewRunnableFunction("MediaFormatReader::StopMediaDump",
+                             [self = RefPtr{this}]() {
+                               self->mMediaDumpStopped = true;
+                               self->mDumpMuxer = nullptr;
+                             }));
+  NS_ENSURE_SUCCESS_VOID(rv);
+}
