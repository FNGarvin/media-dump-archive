-
- private:
-  ~MseDumpSink();
-
-  nsCString mPath;
-  FILE* mFile = nullptr;
-  bool mOpenAttempted = false;
-};
-
-// Dumps every byte buffer appended to one SourceBuffer, in order, to its own
-// file on disk -- a faithful, directly remuxable copy of what the page's JS
-// player handed to MSE, captured before Gecko does any of its own demuxing.
-//
-// Enabled by setting MOZ_MSE_DUMP_DIR to a directory. As with WavDumper's
-// MOZ_DUMP_AUDIO, the content-process sandbox needs to be disabled
-// (MOZ_DISABLE_CONTENT_SANDBOX=1) for the file open to succeed.
-//
-// AppendAsync must be called on the main thread; the actual file I/O runs on
-// a dedicated background TaskQueue so SourceBuffer::AppendData never blocks
-// on disk.
-class MseStreamDumper final {
- public:
-  MseStreamDumper() = default;
-  ~MseStreamDumper() = default;
-
-  // Explicitly arm dumping to aDirPath, e.g. from a chrome-triggered
-  // context-menu action (see HTMLMediaElement::StartMseDump). Idempotent;
-  // takes priority over the MOZ_MSE_DUMP_DIR env var.
-  void Arm(const nsACString& aDirPath);
-
-  // Stops accepting further appends. Bytes already written stay on disk and
-  // remain playable (fMP4 fragments are valid as a prefix); this does not
-  // retroactively remove them or close the file early.
-  void Stop() { mStopped = true; }
-
-  void AppendAsync(const RefPtr<MediaByteBuffer>& aData);
-
- private:
-  static bool GetDumpDirFromEnv(nsACString& aDir);
-  void InitWithDir(const nsACString& aDir);
-
-  bool mInitialized = false;
-  bool mStopped = false;
-  RefPtr<TaskQueue> mTaskQueue;
-  RefPtr<MseDumpSink> mSink;
-};
