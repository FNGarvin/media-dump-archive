diff --git a/dom/media/MediaDumpMuxer.cpp b/dom/media/MediaDumpMuxer.cpp
new file mode 100644
index 000000000000..deb8ce42ef90
--- /dev/null
+++ b/dom/media/MediaDumpMuxer.cpp
@@ -0,0 +1,236 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "MediaDumpMuxer.h"
+
+#include <limits>
+
+#include "MediaData.h"
+#include "MediaInfo.h"
+#include "VideoUtils.h"
+#include "libmkv/EbmlIDs.h"
+#include "libmkv/EbmlWriter.h"
+#include "libmkv/WebMElement.h"
+#include "mozilla/Atomics.h"
+#include "mozilla/UniquePtr.h"
+#include "nsThreadUtils.h"
+
+#ifdef XP_WIN
+#  include "nsString.h"
+#endif
+
+namespace mozilla {
+
+// Timecode scale in nanoseconds -- SimpleBlock timecodes below are in
+// milliseconds, matching TIME_CODE_SCALE = 1e6ns = 1ms.
+constexpr unsigned long kTimeCodeScale = 1000000;
+constexpr int32_t kHeaderBudget = 4096;
+constexpr int64_t kMaxBlockTimecodeMs = std::numeric_limits<int16_t>::max();
+constexpr int64_t kNewClusterAfterMs = 1000;
+static_assert(kNewClusterAfterMs <= kMaxBlockTimecodeMs);
+
+// Returns "" if aMimeType isn't a codec this muxer knows how to write.
+static nsAutoCString MapVideoCodecId(const nsCString& aMimeType) {
+  nsAutoCString id;
+  if (aMimeType.EqualsLiteral("video/vp8")) {
+    id.AssignLiteral("V_VP8");
+  } else if (aMimeType.EqualsLiteral("video/vp9")) {
+    id.AssignLiteral("V_VP9");
+  }
+  // video/avc (H.264), video/av1, etc. intentionally not yet supported --
+  // H.264 and AAC need extra codec-private reformatting (avcC / bare
+  // AudioSpecificConfig extraction) not yet implemented here.
+  return id;
+}
+
+static nsAutoCString MapAudioCodecId(const nsCString& aMimeType) {
+  nsAutoCString id;
+  if (aMimeType.EqualsLiteral("audio/opus")) {
+    id.AssignLiteral("A_OPUS");
+  } else if (aMimeType.EqualsLiteral("audio/vorbis")) {
+    id.AssignLiteral("A_VORBIS");
+  }
+  return id;
+}
+
+void MediaDumpSink::Write(const nsTArray<uint8_t>& aBytes) {
+  if (!mFile && !mOpenAttempted) {
+    mOpenAttempted = true;
+#ifdef XP_WIN
+    nsAutoString widePath = NS_ConvertUTF8toUTF16(mPath);
+    mFile = _wfopen(widePath.get(), L"wb");
+#else
+    mFile = fopen(mPath.get(), "wb");
+#endif
+    if (!mFile) {
+      NS_WARNING(
+          "MediaDumpMuxer: could not open dump file. Is the content "
+          "sandbox disabled (MOZ_DISABLE_CONTENT_SANDBOX=1)?");
+    }
+  }
+  if (!mFile) {
+    return;
+  }
+  (void)fwrite(aBytes.Elements(), 1, aBytes.Length(), mFile);
+  fflush(mFile);
+}
+
+MediaDumpSink::~MediaDumpSink() {
+  if (mFile) {
+    fclose(mFile);
+  }
+}
+
+void MediaDumpMuxer::DispatchWrite(nsTArray<uint8_t>&& aBytes) {
+  if (!mSink) {
+    return;
+  }
+  RefPtr<MediaDumpSink> sink = mSink;
+  nsresult rv = mTaskQueue->Dispatch(NS_NewRunnableFunction(
+      "MediaDumpMuxer::DispatchWrite",
+      [sink, bytes = std::move(aBytes)]() { sink->Write(bytes); }));
+  NS_ENSURE_SUCCESS_VOID(rv);
+}
+
+void MediaDumpMuxer::Init(const nsACString& aDirPath, const VideoInfo* aVideo,
+                          const AudioInfo* aAudio) {
+  MOZ_ASSERT(!mInitialized);
+  mInitialized = true;
+
+  nsAutoCString videoCodecId, audioCodecId;
+  if (aVideo) {
+    videoCodecId = MapVideoCodecId(aVideo->mMimeType);
+  }
+  if (aAudio) {
+    audioCodecId = MapAudioCodecId(aAudio->mMimeType);
+  }
+
+  mHasVideo = aVideo && !videoCodecId.IsEmpty();
+  mHasAudio = aAudio && !audioCodecId.IsEmpty();
+  if (!mHasVideo && !mHasAudio) {
+    return;  // Nothing this muxer can write; stay disarmed.
+  }
+
+  mVideoTrackNumber = mHasVideo ? 1 : 0;
+  mAudioTrackNumber = mHasVideo ? 2 : 1;
+
+  RefPtr<MediaByteBuffer> audioPrivate;
+  if (mHasAudio) {
+    audioPrivate = ForceGetAudioCodecSpecificBlob(aAudio->mCodecSpecificConfig);
+  }
+
+  auto bufSize = size_t(kHeaderBudget) +
+                 (audioPrivate ? audioPrivate->Length() : 0);
+  auto buffer = MakeUnique<uint8_t[]>(bufSize);
+  EbmlGlobal ebml;
+  ebml.buf = buffer.get();
+  ebml.offset = 0;
+
+  writeHeader(&ebml);
+  {
+    EbmlLoc segEbmlLoc, seekEbmlLoc, infoEbmlLoc;
+    Ebml_StartSubElement(&ebml, &segEbmlLoc, Segment);
+    Ebml_StartSubElement(&ebml, &seekEbmlLoc, SeekHead);
+    // As in EbmlComposer: exact sizes aren't known ahead of time, so this
+    // section is intentionally left empty.
+    Ebml_EndSubElement(&ebml, &seekEbmlLoc);
+    writeSegmentInformation(&ebml, &infoEbmlLoc, kTimeCodeScale, 0);
+    {
+      EbmlLoc trackLoc;
+      Ebml_StartSubElement(&ebml, &trackLoc, Tracks);
+      if (mHasVideo) {
+        writeVideoTrack(&ebml, mVideoTrackNumber, 0, videoCodecId.get(),
+                        aVideo->mImage.width, aVideo->mImage.height,
+                        aVideo->mDisplay.width, aVideo->mDisplay.height);
+      }
+      if (mHasAudio) {
+        writeAudioTrack(&ebml, mAudioTrackNumber, 0, audioCodecId.get(),
+                        aAudio->mRate, aAudio->mChannels,
+                        /* codecDelay */ 0, /* seekPreRoll */ 0,
+                        audioPrivate ? audioPrivate->Elements() : nullptr,
+                        audioPrivate ? audioPrivate->Length() : 0);
+      }
+      Ebml_EndSubElement(&ebml, &trackLoc);
+    }
+    // The Segment's size is left unknown, same as EbmlComposer -- this file
+    // is written incrementally and its final size isn't known up front.
+  }
+  MOZ_ASSERT(ebml.offset <= bufSize);
+
+  nsTArray<uint8_t> header;
+  header.AppendElements(buffer.get(), ebml.offset);
+
+  static Atomic<uint32_t> sNextDumpId(0);
+  nsAutoCString path;
+  path.AppendPrintf("%s/mediadump-%u.mkv",
+                    PromiseFlatCString(aDirPath).get(), ++sNextDumpId);
+  mSink = new MediaDumpSink(std::move(path));
+
+  RefPtr<SharedThreadPool> pool =
+      GetMediaThreadPool(MediaThreadType::SUPERVISOR);
+  if (!pool) {
+    NS_WARNING("MediaDumpMuxer: failed to get thread pool");
+    mSink = nullptr;
+    return;
+  }
+  mTaskQueue = TaskQueue::Create(pool.forget(), "MediaDumpMuxer");
+
+  DispatchWrite(std::move(header));
+}
+
+void MediaDumpMuxer::WriteSample(bool aIsVideo, MediaRawData* aSample) {
+  if (!mSink) {
+    return;
+  }
+  if ((aIsVideo && !mHasVideo) || (!aIsVideo && !mHasAudio)) {
+    return;
+  }
+  if (aSample->mCrypto.IsEncrypted()) {
+    // EME/DRM content: never surface decrypted bytes here, so just drop it.
+    return;
+  }
+
+  const bool isVideoKeyframe = aIsVideo && aSample->mKeyframe;
+  if (aIsVideo && !aSample->mKeyframe && !mHasWrittenCluster) {
+    // Never start the file on a non-keyframe video sample.
+    return;
+  }
+
+  const int64_t sampleTimeMs = aSample->mTime.ToMilliseconds();
+  int64_t timeCodeMs = sampleTimeMs - mCurrentClusterTimecodeMs;
+  const bool needClusterHeader =
+      !mHasWrittenCluster || timeCodeMs >= kNewClusterAfterMs ||
+      isVideoKeyframe;
+
+  auto block = MakeUnique<uint8_t[]>(size_t(kHeaderBudget) + aSample->Size());
+  EbmlGlobal ebml;
+  ebml.buf = block.get();
+  ebml.offset = 0;
+
+  if (needClusterHeader) {
+    mHasWrittenCluster = true;
+    EbmlLoc clusterLoc;
+    // As in EbmlComposer: never explicitly ended, so the muxer doesn't need
+    // to buffer a whole cluster in memory to know its final size -- the
+    // next cluster's start implicitly ends this one.
+    Ebml_StartSubElement(&ebml, &clusterLoc, Cluster);
+    mCurrentClusterTimecodeMs = sampleTimeMs;
+    Ebml_SerializeUnsigned(&ebml, Timecode, mCurrentClusterTimecodeMs);
+    timeCodeMs = 0;
+  }
+
+  MOZ_ASSERT(timeCodeMs >= 0 && timeCodeMs < kNewClusterAfterMs);
+
+  writeSimpleBlock(&ebml, aIsVideo ? mVideoTrackNumber : mAudioTrackNumber,
+                   static_cast<int16_t>(timeCodeMs), isVideoKeyframe,
+                   /* lacingFlag */ 0, /* discardable */ 0,
+                   const_cast<unsigned char*>(aSample->Data()),
+                   aSample->Size());
+
+  nsTArray<uint8_t> bytes;
+  bytes.AppendElements(block.get(), ebml.offset);
+  DispatchWrite(std::move(bytes));
+}
+
+}  // namespace mozilla
diff --git a/dom/media/MediaDumpMuxer.h b/dom/media/MediaDumpMuxer.h
new file mode 100644
index 000000000000..8ca62c3d1d1c
--- /dev/null
+++ b/dom/media/MediaDumpMuxer.h
@@ -0,0 +1,102 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_MediaDumpMuxer_h_
+#define mozilla_MediaDumpMuxer_h_
+
+#include <stdio.h>
+
+#include "mozilla/RefPtr.h"
+#include "mozilla/TaskQueue.h"
+#include "nsISupportsImpl.h"
+#include "nsString.h"
+#include "nsTArray.h"
+
+namespace mozilla {
+
+class MediaRawData;
+class VideoInfo;
+class AudioInfo;
+
+// Owns the on-disk file a MediaDumpMuxer writes to. Lives only on the
+// muxer's TaskQueue; a RefPtr to it is captured by every dispatched write
+// task instead of a raw pointer, so it stays alive exactly as long as there
+// is queued work left, even if the owning MediaFormatReader is destroyed
+// first (see MseDumpSink in the mediasource/ directory for the same idiom).
+class MediaDumpSink final {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(MediaDumpSink)
+
+  explicit MediaDumpSink(nsCString&& aPath) : mPath(std::move(aPath)) {}
+
+  // Must be called on the owning MediaDumpMuxer's TaskQueue.
+  void Write(const nsTArray<uint8_t>& aBytes);
+
+ private:
+  ~MediaDumpSink();
+
+  nsCString mPath;
+  FILE* mFile = nullptr;
+  bool mOpenAttempted = false;
+};
+
+// Muxes demuxed (compressed, pre-decode) audio/video samples into a single
+// Matroska (.mkv) file, regardless of which pipeline produced them -- MSE,
+// a blob: URL, or a plain network URL all end up here, since every one of
+// them flows through MediaFormatReader before decode.
+//
+// Reuses the codec-agnostic low-level EBML primitives in media/libmkv (the
+// same ones WebMWriter/EbmlComposer use for MediaRecorder output), but --
+// unlike EbmlComposer, which hardcodes VP8 video + Opus audio -- takes each
+// track's actual codec ID and codec-private config from its TrackInfo, so
+// it isn't tied to one codec pair. Currently wired up for VP8/VP9 video and
+// Opus/Vorbis audio; unsupported codecs are simply not written (see
+// MapVideoCodecId/MapAudioCodecId in the .cpp).
+//
+// Must only be used from one thread/TaskQueue at a time (the owning
+// MediaFormatReader's), except construction.
+class MediaDumpMuxer final {
+ public:
+  MediaDumpMuxer() = default;
+  ~MediaDumpMuxer() = default;
+
+  // Must be called once, after the final track set for this element is
+  // known (MediaFormatReader knows this from metadata, before any sample is
+  // demuxed) but before any WriteSample call. aVideo/aAudio may be null if
+  // that track doesn't exist. No-op (dump stays permanently disarmed) if
+  // neither track's codec is supported.
+  void Init(const nsACString& aDirPath, const VideoInfo* aVideo,
+            const AudioInfo* aAudio);
+
+  // Feed one demuxed sample for the given track. No-op if Init() wasn't
+  // able to arm that track (unsupported codec) or if the sample is
+  // encrypted (EME/DRM samples are silently dropped, never written).
+  void WriteSample(bool aIsVideo, MediaRawData* aSample);
+
+ private:
+  void WriteHeader(const nsACString& aDirPath, const VideoInfo* aVideo,
+                   const AudioInfo* aAudio);
+  void DispatchWrite(nsTArray<uint8_t>&& aBytes);
+
+  bool mInitialized = false;
+  bool mHasVideo = false;
+  bool mHasAudio = false;
+  uint8_t mVideoTrackNumber = 0;
+  uint8_t mAudioTrackNumber = 0;
+
+  // True once the first Cluster header has been written. Matches
+  // EbmlComposer's approach: clusters are never explicitly closed (that
+  // would require buffering a whole cluster to know its size up front);
+  // the next cluster's start implicitly ends the previous one, which lets
+  // this stream to disk incrementally.
+  bool mHasWrittenCluster = false;
+  int64_t mCurrentClusterTimecodeMs = 0;
+
+  RefPtr<TaskQueue> mTaskQueue;
+  RefPtr<MediaDumpSink> mSink;
+};
+
+}  // namespace mozilla
+
+#endif  // mozilla_MediaDumpMuxer_h_
