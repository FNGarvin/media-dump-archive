+// Opens (creating/truncating as needed) a named file on the IO thread and
+// hands a duplicated handle back to the child, mirroring
+// AnonymousTemporaryFileRequestor above but for a caller-chosen path
+// instead of an anonymous temp file, and replying via a resolver instead
+// of a second IPDL message. See MediaDumpMuxer.h for the content-side use.
+class MediaDumpFileRequestor final : public Runnable {
+ public:
+  MediaDumpFileRequestor(
+      const nsACString& aPath,
+      ContentParent::RequestMediaDumpFileResolver&& aResolver)
+      : Runnable("dom::MediaDumpFileRequestor"),
+        mPath(aPath),
+        mResolver(std::move(aResolver)),
+        mRv(NS_OK),
+        mPRFD(nullptr) {}
+
+  // Only safe to call if this runnable was never successfully dispatched
+  // (i.e. Run() will never execute) -- see RecvRequestMediaDumpFile.
+  void ResolveWithError() {
+    FileDescOrError result(NS_ERROR_FAILURE);
+    mResolver(result);
+  }
+
+  NS_IMETHOD Run() override {
+    if (NS_IsMainThread()) {
+      FileDescOrError result;
+      if (NS_WARN_IF(NS_FAILED(mRv))) {
+        result = mRv;
+      } else {
+        result = FileDescriptor(FileDescriptor::PlatformHandleType(
+            PR_FileDesc2NativeHandle(mPRFD)));
+        // The FileDescriptor object owns a duplicate of the file handle; we
+        // must close the original (and clean up the NSPR descriptor).
+        PR_Close(mPRFD);
+      }
+      mResolver(result);
+      return NS_OK;
+    }
+    mPRFD = PR_Open(mPath.get(), PR_WRONLY | PR_CREATE_FILE | PR_TRUNCATE, 0600);
+    if (!mPRFD) {
+      mRv = NS_ERROR_FAILURE;
+    }
+    NS_DispatchToMainThread(this);
+    return NS_OK;
+  }
+
+ private:
+  nsCString mPath;
+  ContentParent::RequestMediaDumpFileResolver mResolver;
+  nsresult mRv;
+  PRFileDesc* mPRFD;
+};
+
+mozilla::ipc::IPCResult ContentParent::RecvRequestMediaDumpFile(
+    const nsCString& aPath, RequestMediaDumpFileResolver&& aResolver) {
+  nsresult rv = NS_OK;
+  nsCOMPtr<nsIEventTarget> target =
+      do_GetService(NS_STREAMTRANSPORTSERVICE_CONTRACTID, &rv);
+  if (!target) {
+    FileDescOrError result(NS_ERROR_FAILURE);
+    aResolver(result);
+    return IPC_OK();
+  }
+
+  RefPtr<MediaDumpFileRequestor> requestor =
+      new MediaDumpFileRequestor(aPath, std::move(aResolver));
+  rv = target->Dispatch(requestor, NS_DISPATCH_NORMAL);
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    // Dispatch failed synchronously, so Run() never happened and never
+    // will; the resolver moved into requestor would otherwise be silently
+    // dropped without ever being invoked.
+    requestor->ResolveWithError();
+  }
+  return IPC_OK();
+}
