+//
+// A normal content-process tab can't just open an arbitrary path itself --
+// the content sandbox blocks that -- so opening happens in the parent
+// process via the PContent RequestMediaDumpFile IPC round trip (mirroring
+// how FileBlockCache gets an anonymous temp file from the parent, just for
+// a named, user-chosen path instead). That round trip is asynchronous, so
+// writes that arrive before the handle does are buffered in mPendingWrites
+// and flushed, in order, once it's ready.
 class MediaDumpSink final {
  public:
   NS_INLINE_DECL_THREADSAFE_REFCOUNTING(MediaDumpSink)
 
   explicit MediaDumpSink(nsCString&& aPath) : mPath(std::move(aPath)) {}
 
+  // Must be called once, on the owning MediaDumpMuxer's TaskQueue, before
+  // any Write() call. Hops to the main thread to make the actual IPC call.
+  void RequestFileHandle(RefPtr<TaskQueue> aOwnerQueue);
+
   // Must be called on the owning MediaDumpMuxer's TaskQueue.
   void Write(const nsTArray<uint8_t>& aBytes);
 
  private:
   ~MediaDumpSink();
 
+  // Runs on mOwnerQueue once the parent has replied (or the request
+  // failed, in which case aFile is null and every future Write() is a
+  // silent no-op, matching this feature's existing "just drop it" failure
+  // mode when e.g. sandboxing prevented a local open in the direct-fopen
+  // predecessor of this class).
+  void OnFileHandleReady(PRFileDesc* aFile);
+
   nsCString mPath;
-  FILE* mFile = nullptr;
-  bool mOpenAttempted = false;
+  RefPtr<TaskQueue> mOwnerQueue;
+  PRFileDesc* mFile = nullptr;
+  bool mRequestFailed = false;
+  nsTArray<nsTArray<uint8_t>> mPendingWrites;
 };
 
