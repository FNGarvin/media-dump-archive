+void MediaDumpSink::RequestFileHandle(RefPtr<TaskQueue> aOwnerQueue) {
+  mOwnerQueue = std::move(aOwnerQueue);
+
+  if (!dom::ContentChild::GetSingleton()) {
+    // Not in a sandboxed content process (e.g. this is the parent process
+    // itself) -- nothing stops us from just opening the file directly.
+    // Still dispatched through mOwnerQueue rather than done inline: this
+    // may be called from a different queue (see MediaDumpMuxer::Init), and
+    // mFile/mPendingWrites must only ever be touched from mOwnerQueue.
+    RefPtr<MediaDumpSink> self = this;
+    nsCString path = mPath;
+    nsresult rv = mOwnerQueue->Dispatch(NS_NewRunnableFunction(
+        "MediaDumpSink::RequestFileHandle (direct open)",
+        [self, path]() {
+          PRFileDesc* file = PR_Open(
+              path.get(), PR_WRONLY | PR_CREATE_FILE | PR_TRUNCATE, 0600);
+          if (!file) {
+            NS_WARNING("MediaDumpMuxer: could not open dump file directly.");
+          }
+          self->OnFileHandleReady(file);
+        }));
+    NS_ENSURE_SUCCESS_VOID(rv);
+    return;
+  }
+
+  RefPtr<MediaDumpSink> self = this;
+  nsCString path = mPath;
+  // RequestFileHandle() itself may be called from any thread (see
+  // MediaDumpMuxer::Init), but the actual IPC call must happen on the main
+  // thread, matching every other PContent consumer. Re-fetch the singleton
+  // there rather than capturing it now, in case of a shutdown race between
+  // this dispatch and it actually running.
+  nsresult rv = NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "MediaDumpSink::RequestFileHandle", [self, path]() {
+        dom::ContentChild* contentChild = dom::ContentChild::GetSingleton();
+        if (!contentChild) {
+          nsresult rv = self->mOwnerQueue->Dispatch(NS_NewRunnableFunction(
+              "MediaDumpSink::OnFileHandleReady",
+              [self]() { self->OnFileHandleReady(nullptr); }));
+          NS_ENSURE_SUCCESS_VOID(rv);
+          return;
+        }
+        contentChild->SendRequestMediaDumpFile(path)->Then(
+            GetMainThreadSerialEventTarget(), __func__,
+            [self](dom::FileDescOrError&& aResult) {
+              PRFileDesc* file = nullptr;
+              if (aResult.type() ==
+                  dom::FileDescOrError::Type::TFileDescriptor) {
+                auto rawFD =
+                    aResult.get_FileDescriptor().ClonePlatformHandle();
+                file = PR_ImportFile(PROsfd(rawFD.release()));
+              } else {
+                NS_WARNING(
+                    "MediaDumpMuxer: parent could not open dump file. Does "
+                    "the chosen path exist and is it writable?");
+              }
+              // Hand off to mOwnerQueue: mFile/mPendingWrites must only
+              // ever be touched from there.
+              nsresult rv = self->mOwnerQueue->Dispatch(NS_NewRunnableFunction(
+                  "MediaDumpSink::OnFileHandleReady",
+                  [self, file]() { self->OnFileHandleReady(file); }));
+              if (NS_FAILED(rv) && file) {
+                PR_Close(file);
+              }
+            },
+            [self](mozilla::ipc::ResponseRejectReason&&) {
+              nsresult rv = self->mOwnerQueue->Dispatch(
+                  NS_NewRunnableFunction("MediaDumpSink::OnFileHandleReady",
+                                        [self]() {
+                                          self->OnFileHandleReady(nullptr);
+                                        }));
+              NS_ENSURE_SUCCESS_VOID(rv);
+            });
+      }));
+  NS_ENSURE_SUCCESS_VOID(rv);
+}
+
+void MediaDumpSink::OnFileHandleReady(PRFileDesc* aFile) {
+  MOZ_ASSERT(!mFile);
+  if (!aFile) {
+    mRequestFailed = true;
+    mPendingWrites.Clear();
+    return;
+  }
+  mFile = aFile;
+  for (const auto& bytes : mPendingWrites) {
+    Write(bytes);
+  }
+  mPendingWrites.Clear();
+}
