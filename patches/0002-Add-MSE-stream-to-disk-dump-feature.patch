@@ -300,12 +300,40 @@ already_AddRefed<SourceBuffer> MediaSource::AddSourceBuffer(
     return nullptr;
   }
   RefPtr<SourceBuffer> sourceBuffer = new SourceBuffer(this, *containerType);
+  if (mMseDumpArmed) {
+    sourceBuffer->ArmStreamDump(mMseDumpDir);
+  }
   mSourceBuffers->Append(sourceBuffer);
   DDLINKCHILD("sourcebuffer[]", sourceBuffer.get());
   MSE_DEBUG("sourceBuffer={}", fmt::ptr(sourceBuffer.get()));
   return sourceBuffer.forget();
 }
 
+void MediaSource::StartMseDump(const nsACString& aDirPath) {
+  MOZ_ASSERT(NS_IsMainThread());
+  mMseDumpArmed = true;
+  mMseDumpDir = aDirPath;
+  for (uint32_t i = 0; i < mSourceBuffers->Length(); ++i) {
+    bool found = false;
+    SourceBuffer* sourceBuffer = mSourceBuffers->IndexedGetter(i, found);
+    if (found && sourceBuffer) {
+      sourceBuffer->ArmStreamDump(mMseDumpDir);
+    }
+  }
+}
+
+void MediaSource::StopMseDump() {
+  MOZ_ASSERT(NS_IsMainThread());
+  mMseDumpArmed = false;
+  for (uint32_t i = 0; i < mSourceBuffers->Length(); ++i) {
+    bool found = false;
+    SourceBuffer* sourceBuffer = mSourceBuffers->IndexedGetter(i, found);
+    if (found && sourceBuffer) {
+      sourceBuffer->StopStreamDump();
+    }
+  }
+}
