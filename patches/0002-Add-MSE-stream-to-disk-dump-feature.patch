diff --git a/dom/media/mediasource/MseStreamDumper.cpp b/dom/media/mediasource/MseStreamDumper.cpp
new file mode 100644
index 000000000000..651cbcda4901
--- /dev/null
+++ b/dom/media/mediasource/MseStreamDumper.cpp
@@ -0,0 +1,118 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "MseStreamDumper.h"
+
+#include <stdio.h>
+
+#include "MediaData.h"
+#include "VideoUtils.h"
+#include "mozilla/Atomics.h"
+#include "nsThreadUtils.h"
+
+#ifdef XP_WIN
+#  include "nsString.h"
+#endif
+
+namespace mozilla {
+namespace dom {
+
+void MseDumpSink::Write(const RefPtr<MediaByteBuffer>& aData) {
+  if (!mFile && !mOpenAttempted) {
+    mOpenAttempted = true;
+#ifdef XP_WIN
+    nsAutoString widePath = NS_ConvertUTF8toUTF16(mPath);
+    mFile = _wfopen(widePath.get(), L"wb");
+#else
+    mFile = fopen(mPath.get(), "wb");
+#endif
+    if (!mFile) {
+      NS_WARNING(
+          "MseStreamDumper: could not open dump file. Is the content "
+          "sandbox disabled (MOZ_DISABLE_CONTENT_SANDBOX=1)?");
+    }
+  }
+  if (!mFile) {
+    return;
+  }
+  (void)fwrite(aData->Elements(), 1, aData->Length(), mFile);
+  fflush(mFile);
+}
+
+MseDumpSink::~MseDumpSink() {
+  if (mFile) {
+    fclose(mFile);
+  }
+}
+
+/* static */
+bool MseStreamDumper::GetDumpDirFromEnv(nsACString& aDir) {
+  const char* dir = getenv("MOZ_MSE_DUMP_DIR");
+  if (!dir || !dir[0]) {
+    return false;
+  }
+  aDir.Assign(dir);
+  return true;
+}
+
+void MseStreamDumper::InitWithDir(const nsACString& aDir) {
+  MOZ_ASSERT(NS_IsMainThread());
+  MOZ_ASSERT(!mInitialized);
+  mInitialized = true;
+
+  static Atomic<uint32_t> sNextDumpId(0);
+  nsAutoCString path;
+  path.AppendPrintf("%s/msedump-%u.mp4", PromiseFlatCString(aDir).get(),
+                    ++sNextDumpId);
+
+  mSink = new MseDumpSink(std::move(path));
+
+  RefPtr<SharedThreadPool> pool =
+      GetMediaThreadPool(MediaThreadType::SUPERVISOR);
+  if (!pool) {
+    NS_WARNING("MseStreamDumper: failed to get thread pool");
+    mSink = nullptr;
+    return;
+  }
+  mTaskQueue = TaskQueue::Create(pool.forget(), "MseStreamDumper");
+}
+
+void MseStreamDumper::Arm(const nsACString& aDirPath) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mInitialized) {
+    return;  // Already armed (env var or a prior Arm() call); first wins.
+  }
+  InitWithDir(aDirPath);
+}
+
+void MseStreamDumper::AppendAsync(const RefPtr<MediaByteBuffer>& aData) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  if (mStopped) {
+    return;
+  }
+
+  if (!mInitialized) {
+    nsAutoCString dir;
+    if (!GetDumpDirFromEnv(dir)) {
+      mInitialized = true;
+      return;  // Feature disabled; mSink stays null, every call is a no-op.
+    }
+    InitWithDir(dir);
+  }
+
+  if (!mSink) {
+    return;
+  }
+
+  RefPtr<MseDumpSink> sink = mSink;
+  RefPtr<MediaByteBuffer> data = aData;
+  nsresult rv = mTaskQueue->Dispatch(NS_NewRunnableFunction(
+      "MseStreamDumper::AppendAsync",
+      [sink, data]() { sink->Write(data); }));
+  NS_ENSURE_SUCCESS_VOID(rv);
+}
+
+}  // namespace dom
+}  // namespace mozilla
diff --git a/dom/media/mediasource/MseStreamDumper.h b/dom/media/mediasource/MseStreamDumper.h
new file mode 100644
index 000000000000..1e56c9055f79
--- /dev/null
+++ b/dom/media/mediasource/MseStreamDumper.h
@@ -0,0 +1,83 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_dom_MseStreamDumper_h_
+#define mozilla_dom_MseStreamDumper_h_
+
+#include "mozilla/RefPtr.h"
+#include "mozilla/TaskQueue.h"
+#include "nsISupportsImpl.h"
+#include "nsString.h"
+
+namespace mozilla {
+
+class MediaByteBuffer;
+
+namespace dom {
+
+// Owns the on-disk file a single SourceBuffer's appended bytes are written
+// to. Lives only on the MseStreamDumper's TaskQueue after construction; a
+// RefPtr to it is captured by every dispatched write task instead of a raw
+// SourceBuffer/MseStreamDumper pointer, so it stays alive exactly as long as
+// there is queued work left, even if the owning SourceBuffer is destroyed
+// first.
+class MseDumpSink final {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(MseDumpSink)
+
+  explicit MseDumpSink(nsCString&& aPath) : mPath(std::move(aPath)) {}
+
+  // Must be called on the owning MseStreamDumper's TaskQueue.
+  void Write(const RefPtr<MediaByteBuffer>& aData);
+
+ private:
+  ~MseDumpSink();
+
+  nsCString mPath;
+  FILE* mFile = nullptr;
+  bool mOpenAttempted = false;
+};
+
+// Dumps every byte buffer appended to one SourceBuffer, in order, to its own
+// file on disk -- a faithful, directly remuxable copy of what the page's JS
+// player handed to MSE, captured before Gecko does any of its own demuxing.
+//
+// Enabled by setting MOZ_MSE_DUMP_DIR to a directory. As with WavDumper's
+// MOZ_DUMP_AUDIO, the content-process sandbox needs to be disabled
+// (MOZ_DISABLE_CONTENT_SANDBOX=1) for the file open to succeed.
+//
+// AppendAsync must be called on the main thread; the actual file I/O runs on
+// a dedicated background TaskQueue so SourceBuffer::AppendData never blocks
+// on disk.
+class MseStreamDumper final {
+ public:
+  MseStreamDumper() = default;
+  ~MseStreamDumper() = default;
+
+  // Explicitly arm dumping to aDirPath, e.g. from a chrome-triggered
+  // context-menu action (see HTMLMediaElement::StartMseDump). Idempotent;
+  // takes priority over the MOZ_MSE_DUMP_DIR env var.
+  void Arm(const nsACString& aDirPath);
+
+  // Stops accepting further appends. Bytes already written stay on disk and
+  // remain playable (fMP4 fragments are valid as a prefix); this does not
+  // retroactively remove them or close the file early.
+  void Stop() { mStopped = true; }
+
+  void AppendAsync(const RefPtr<MediaByteBuffer>& aData);
+
+ private:
+  static bool GetDumpDirFromEnv(nsACString& aDir);
+  void InitWithDir(const nsACString& aDir);
+
+  bool mInitialized = false;
+  bool mStopped = false;
+  RefPtr<TaskQueue> mTaskQueue;
+  RefPtr<MseDumpSink> mSink;
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_MseStreamDumper_h_
