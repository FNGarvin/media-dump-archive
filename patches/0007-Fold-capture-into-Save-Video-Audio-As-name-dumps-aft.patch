-    const fp = Cc["@mozilla.org/filepicker;1"].createInstance(
-      Ci.nsIFilePicker
-    );
-    fp.init(
-      this.window.browsingContext,
-      "Choose a folder to dump the media stream to",
-      Ci.nsIFilePicker.modeGetFolder
