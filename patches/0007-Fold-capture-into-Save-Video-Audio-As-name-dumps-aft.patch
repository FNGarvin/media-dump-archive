-      this.mediaCommand("dumpMediaStream", fp.file.path);
+    this.actor.getFrameTitle(this.targetIdentifier).then(title => {
+      const fp = Cc["@mozilla.org/filepicker;1"].createInstance(
+        Ci.nsIFilePicker
+      );
+      fp.init(
+        this.window.browsingContext,
+        "Choose a folder to dump the media stream to",
+        Ci.nsIFilePicker.modeGetFolder
+      );
+      fp.open(rv => {
+        if (
+          rv != Ci.nsIFilePicker.returnOK &&
+          rv != Ci.nsIFilePicker.returnReplace
+        ) {
+          return;
+        }
+        // MediaDumpMuxer treats this as a filename prefix, not a bare
+        // directory -- it appends "-<timestamp>-<n>.mkv" itself. Build in
+        // the page title here so dumps are identifiable without having to
+        // open them first.
+        const safeTitle = lazy.DownloadPaths.sanitize(title || "media");
+        const prefix = PathUtils.join(fp.file.path, safeTitle);
+        this.mediaCommand("dumpMediaStream", prefix);
+      });
     });
   }
 
