diff --git a/.personal-build/run-media-dump-build.bat b/.personal-build/run-media-dump-build.bat
new file mode 100644
index 000000000000..8d9087cf56a2
--- /dev/null
+++ b/.personal-build/run-media-dump-build.bat
@@ -0,0 +1,26 @@
+@echo off
+rem Launches the custom media-dump Firefox build. Media dumps now write via
+rem the parent process (see dom/ipc/PContent.ipdl's RequestMediaDumpFile),
+rem so the content sandbox no longer needs to be disabled for this feature.
+rem
+rem This is the archived/tracked copy of this script (lives in the repo, so
+rem it travels with the code). A convenience copy normally also sits one
+rem level up, at the root of the whole mozilla checkout (sibling to
+rem mozilla-source/ and mozilla-build/) -- see SETUP.md in this directory
+rem for how to recreate that layout from scratch on a new machine.
+
+setlocal
+rem This script lives in <root>\mozilla-source\.personal-build\, so
+rem MozillaBuild is two levels up, and mozilla-source is one level up.
+set "MOZILLABUILD=%~dp0..\..\mozilla-build"
+rem If something breaks and you want to isolate whether it's sandbox-related,
+rem uncomment the next line to fall back to the old direct-write behavior:
+rem set "MOZ_DISABLE_CONTENT_SANDBOX=1"
+
+cd /d "%~dp0.."
+call mach run
+
+echo.
+echo ==== mach run exited (code %ERRORLEVEL%) ====
+pause
+endlocal
diff --git a/.personal-build/update-and-build.ps1 b/.personal-build/update-and-build.ps1
new file mode 100644
index 000000000000..48e7244cfe8e
--- /dev/null
+++ b/.personal-build/update-and-build.ps1
@@ -0,0 +1,146 @@
+#!/usr/bin/env pwsh
+# Pull latest origin/main, rebase the media-dump feature branch onto it,
+# re-purge the AI-agent breadcrumb files, and rebuild.
+#
+# Usage: .\.personal-build\update-and-build.ps1 [-SkipBuild] [-Package]
+#   -SkipBuild   Stop after the git update/purge steps; don't build at all.
+#   -Package     Also run `mach build package` (produces both the portable zip
+#                and, as an automatic side effect on Windows, the installer
+#                .exe -- there's no separate installer build step). Prefer
+#                package-for-transport.ps1 instead when you actually want to
+#                ship a build somewhere: it collects and labels the artifacts
+#                properly instead of leaving them buried under the obj dir.
+
+param(
+    [switch]$SkipBuild,
+    [switch]$Package
+)
+
+$ErrorActionPreference = "Stop"
+$RepoRoot = Split-Path -Parent $PSScriptRoot
+Set-Location $RepoRoot
+
+# mach defaults to looking for MozillaBuild at C:\mozilla-build; this setup
+# has it under the repo's parent directory instead.
+if (-not (Test-Path env:MOZILLABUILD)) {
+    $env:MOZILLABUILD = "E:\mozilla\mozilla-build"
+}
+
+function Fail($msg) {
+    Write-Error $msg
+    exit 1
+}
+
+# Runs `mach.ps1 build [$Target]`, and if it fails specifically because
+# upstream changed low-level build files (e.g. the libwebrtc-vendoring
+# incident that hit this checkout once already), clobbers and retries once
+# automatically -- that failure mode is expected/routine after a stale
+# checkout catches up, not something to stop and ask about every time.
+function Invoke-MachBuild {
+    param([string]$Target = "")
+    $logFile = Join-Path $env:TEMP "mach-build-$([guid]::NewGuid()).log"
+    if ($Target) {
+        & .\mach.ps1 build $Target 2>&1 | Tee-Object -FilePath $logFile
+    } else {
+        & .\mach.ps1 build 2>&1 | Tee-Object -FilePath $logFile
+    }
+    if ($LASTEXITCODE -eq 0) {
+        Remove-Item $logFile -ErrorAction SilentlyContinue
+        return
+    }
+
+    $needsClobber = Select-String -Path $logFile -Pattern "clobber" -Quiet
+    Remove-Item $logFile -ErrorAction SilentlyContinue
+    if (-not $needsClobber) {
+        Fail "mach build $Target failed (not a clobber issue -- see output above)."
+    }
+
+    Write-Host "== Upstream changed low-level build files; clobbering and retrying (this will be a full rebuild) ==" -ForegroundColor Yellow
+    & .\mach.ps1 clobber
+    if ($LASTEXITCODE -ne 0) { Fail "mach clobber failed." }
+
+    if ($Target) {
+        & .\mach.ps1 build $Target
+    } else {
+        & .\mach.ps1 build
+    }
+    if ($LASTEXITCODE -ne 0) { Fail "mach build $Target failed even after clobbering." }
+}
+
+Write-Host "== Checking working tree state ==" -ForegroundColor Cyan
+$currentBranch = git rev-parse --abbrev-ref HEAD
+if ($currentBranch -ne "media-dump") {
+    Fail "Expected to be on branch 'media-dump', currently on '$currentBranch'. Switch manually and re-run."
+}
+
+$dirty = git status --porcelain
+if ($dirty) {
+    Write-Host $dirty
+    Fail "Working tree has uncommitted changes. Commit or stash them before running this script."
+}
+
+Write-Host "== Fetching origin ==" -ForegroundColor Cyan
+git fetch origin
+if ($LASTEXITCODE -ne 0) { Fail "git fetch failed." }
+
+Write-Host "== Fast-forwarding main to origin/main ==" -ForegroundColor Cyan
+git checkout main
+if ($LASTEXITCODE -ne 0) { Fail "Could not check out main." }
+git reset --hard origin/main
+if ($LASTEXITCODE -ne 0) { Fail "Could not reset main to origin/main." }
+
+Write-Host "== Rebasing media-dump onto main ==" -ForegroundColor Cyan
+git checkout media-dump
+if ($LASTEXITCODE -ne 0) { Fail "Could not check out media-dump." }
+git rebase main
+if ($LASTEXITCODE -ne 0) {
+    Write-Host ""
+    Write-Host "Rebase stopped with conflicts. Resolve manually:" -ForegroundColor Yellow
+    git status --porcelain | Where-Object { $_ -match '^(UU|AA|DD|AU|UA|UD|DU)' }
+    Write-Host ""
+    Write-Host "After resolving: git rebase --continue" -ForegroundColor Yellow
+    Write-Host "(This script will not resolve conflicts or abort the rebase for you.)"
+    exit 1
+}
+
+Write-Host "== Re-purging agent-breadcrumb paths ==" -ForegroundColor Cyan
+$manifest = Join-Path $PSScriptRoot "poison-paths.txt"
+if (-not (Test-Path $manifest)) {
+    Fail "Missing manifest: $manifest"
+}
+$purged = @()
+foreach ($line in Get-Content $manifest) {
+    $path = $line.Trim()
+    if ([string]::IsNullOrWhiteSpace($path) -or $path.StartsWith("#")) { continue }
+    $full = Join-Path $RepoRoot $path
+    if (Test-Path $full) {
+        Remove-Item -Recurse -Force $full
+        $purged += $path
+    }
+}
+if ($purged.Count -gt 0) {
+    Write-Host "Purged: $($purged -join ', ')"
+} else {
+    Write-Host "Nothing to purge (already clean)."
+}
+
+if ($SkipBuild) {
+    Write-Host "== -SkipBuild passed, stopping before build ==" -ForegroundColor Yellow
+    exit 0
+}
+
+Write-Host "== Building ==" -ForegroundColor Cyan
+Invoke-MachBuild
+
+if ($Package) {
+    Write-Host "== Packaging ==" -ForegroundColor Cyan
+    Invoke-MachBuild -Target "package"
+}
+
+Write-Host ""
+Write-Host "== Done ==" -ForegroundColor Green
+if ($Package) {
+    Write-Host "Run .\.personal-build\package-for-transport.ps1 to collect the packaged artifact(s) into an easy-to-find, labeled folder."
+} else {
+    Write-Host "Build is up to date. Run .\.personal-build\package-for-transport.ps1 when you want to ship this build to another PC."
+}
-- 
